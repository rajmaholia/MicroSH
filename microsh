#!/usr/bin/env bash

set -euo pipefail

# ============================================================
# MicroSH
# Tiny Linux application manager
#
# v0.1
#
# Commands:
#   microsh list
#   microsh update
#   microsh install <app>
#   microsh install <app>@<version>
#   microsh uninstall <app>
# ============================================================

VERSION="0.1.0"

# ------------------------------------------------------------
# MicroSH Registry
# ------------------------------------------------------------

CATALOG_USER="rajmaholia"
CATALOG_REPO="MicroSH-Catalog"
CATALOG_BRANCH="main"

CATALOG_URL="https://raw.githubusercontent.com/${CATALOG_USER}/${CATALOG_REPO}/${CATALOG_BRANCH}/catalog.json"

# ------------------------------------------------------------
# Local directories
# ------------------------------------------------------------

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/microsh"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/microsh"

CATALOG="$CACHE_DIR/catalog.json"
INSTALLED="$DATA_DIR/installed"
APP_DIR="$DATA_DIR/apps"

mkdir -p "$CACHE_DIR"
mkdir -p "$DATA_DIR"
mkdir -p "$APP_DIR"

# ------------------------------------------------------------
# Helpers
# ------------------------------------------------------------

error() {
  echo "MicroSH: error: $*" >&2
  exit 1
}

info() {
  echo "MicroSH: $*"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 ||
    error "required command '$1' is not installed"
}

check_dependencies() {
  require_command curl
  require_command jq
  require_command tar
}

download() {
  curl -fL --retry 3 --retry-delay 1 "$1"
}

# ------------------------------------------------------------
# Catalog
# ------------------------------------------------------------

download_catalog() {
  local temporary

  temporary="$(mktemp)"

  info "Updating application catalog..."

  if ! download "$CATALOG_URL" >"$temporary"; then
    rm -f "$temporary"
    error "could not download MicroSH catalog"
  fi

  if ! jq -e '
        type == "object"
        and (.["catalog-version"] | type == "number")
        and (.apps | type == "object")
      ' "$temporary" >/dev/null 2>&1; then

    rm -f "$temporary"
    error "downloaded catalog has an invalid format"
  fi

  mv "$temporary" "$CATALOG"

  info "Catalog updated."
}

catalog_exists() {
  [[ -f "$CATALOG" ]]
}

ensure_catalog() {
  if ! catalog_exists; then
    download_catalog
  fi
}

app_exists() {
  local app="$1"

  jq -e \
    --arg app "$app" \
    '.apps | has($app)' \
    "$CATALOG" >/dev/null
}

latest_version() {
  local app="$1"

  jq -r \
    --arg app "$app" \
    '.apps[$app].latest' \
    "$CATALOG"
}

version_exists() {
  local app="$1"
  local version="$2"

  jq -e \
    --arg app "$app" \
    --arg version "$version" \
    '.apps[$app].versions | has($version)' \
    "$CATALOG" >/dev/null
}

package_url() {
  local app="$1"
  local version="$2"

  jq -r \
    --arg app "$app" \
    --arg version "$version" \
    '.apps[$app].versions[$version].url' \
    "$CATALOG"
}

package_sha256() {
  local app="$1"
  local version="$2"

  jq -r \
    --arg app "$app" \
    --arg version "$version" \
    '.apps[$app].versions[$version].sha256 // empty' \
    "$CATALOG"
}

# ------------------------------------------------------------
# Installed applications
#
# Format:
#
#   Qnote 1.9.9
#   Todo 2.1.0
# ------------------------------------------------------------

installed_version() {
  local app="$1"

  [[ -f "$INSTALLED" ]] || return 1

  awk -v app="$app" '$1 == app {print $2; exit}' "$INSTALLED"
}

is_installed() {
  local app="$1"

  installed_version "$app" >/dev/null
}

mark_installed() {
  local app="$1"
  local version="$2"

  touch "$INSTALLED"

  grep -v "^${app} " "$INSTALLED" >"$INSTALLED.tmp" || true

  echo "$app $version" >>"$INSTALLED.tmp"

  mv "$INSTALLED.tmp" "$INSTALLED"
}

mark_uninstalled() {
  local app="$1"

  [[ -f "$INSTALLED" ]] || return 0

  grep -v "^${app} " "$INSTALLED" >"$INSTALLED.tmp" || true

  mv "$INSTALLED.tmp" "$INSTALLED"
}

# ------------------------------------------------------------
# Package archive
# ------------------------------------------------------------

verify_checksum() {
  local archive="$1"
  local expected="$2"

  [[ -z "$expected" ]] && return 0

  require_command sha256sum

  local actual

  actual="$(sha256sum "$archive" | awk '{print $1}')"

  if [[ "$actual" != "$expected" ]]; then
    error "SHA256 checksum verification failed"
  fi

  info "Checksum verified."
}

extract_archive() {
  local archive="$1"
  local destination="$2"

  case "$archive" in

  *.tar.gz | *.tgz)
    tar -xzf "$archive" -C "$destination"
    ;;

  *.tar.bz2 | *.tbz2)
    tar -xjf "$archive" -C "$destination"
    ;;

  *.tar.xz | *.txz)
    tar -xJf "$archive" -C "$destination"
    ;;

  *.tar)
    tar -xf "$archive" -C "$destination"
    ;;

  *.zip)
    require_command unzip
    unzip -q "$archive" -d "$destination"
    ;;

  *)
    error "unsupported package archive format: $archive"
    ;;

  esac
}

# ------------------------------------------------------------
# Locate extracted application
# ------------------------------------------------------------

find_package_root() {
  local directory="$1"

  # Normal package layout:
  #
  # package/
  # ├── install.sh
  # └── ...

  if [[ -f "$directory/install.sh" ]]; then
    echo "$directory"
    return 0
  fi

  # Also support archives containing one top-level directory:
  #
  # package/
  #   Qnote/
  #     install.sh

  local entries=()

  while IFS= read -r -d '' entry; do
    entries+=("$entry")
  done < <(find "$directory" -mindepth 1 -maxdepth 1 -print0)

  if [[ "${#entries[@]}" -eq 1 ]] &&
    [[ -d "${entries[0]}" ]] &&
    [[ -f "${entries[0]}/install.sh" ]]; then

    echo "${entries[0]}"
    return 0
  fi

  return 1
}

# ------------------------------------------------------------
# Uninstall existing application
# ------------------------------------------------------------

uninstall_existing() {
  local app="$1"
  local app_dir="$APP_DIR/$app"
  local uninstaller="$app_dir/uninstall.sh"

  if [[ ! -d "$app_dir" ]]; then
    mark_uninstalled "$app"
    return 0
  fi

  info "Removing existing '$app'..."

  if [[ ! -f "$uninstaller" ]]; then
    error "'$app' is installed but does not provide uninstall.sh"
  fi

  chmod +x "$uninstaller"

  (
    cd "$app_dir"
    ./uninstall.sh
  )

  rm -rf "$app_dir"

  mark_uninstalled "$app"
}

# ------------------------------------------------------------
# Commands
# ------------------------------------------------------------

cmd_list() {

  ensure_catalog

  echo
  echo "MicroSH Apps"
  echo "------------"

  jq -r '
    .apps
    | to_entries[]
    | "  \(.key)  \(.value.latest)"
  ' "$CATALOG"

  echo
}

cmd_update() {

  download_catalog

  echo
  echo "Available applications:"
  jq -r '
    .apps
    | to_entries[]
    | "  \(.key)  \(.value.latest)"
  ' "$CATALOG"

  echo
}

cmd_install() {

  local specification="$1"

  local app
  local version
  local latest
  local url
  local checksum

  local temporary_dir
  local archive
  local package_root
  local app_dir
  local installer

  # ----------------------------------------------------------
  # Parse:
  #
  #   Qnote
  #   Qnote@1.5.0
  # ----------------------------------------------------------

  if [[ "$specification" == *@* ]]; then
    app="${specification%@*}"
    version="${specification##*@}"

    [[ -n "$app" ]] ||
      error "invalid application name"

    [[ -n "$version" ]] ||
      error "invalid version"

  else
    app="$specification"
    version=""
  fi

  ensure_catalog

  if ! app_exists "$app"; then
    error "application '$app' is not in the microsh catalog"
  fi

  # ----------------------------------------------------------
  # Select version
  # ----------------------------------------------------------

  if [[ -z "$version" ]]; then
    version="$(latest_version "$app")"

    [[ -n "$version" ]] ||
      error "no latest version is defined for '$app'"
  else
    if ! version_exists "$app" "$version"; then
      error "version '$version' of '$app' is not available"
    fi
  fi

  url="$(package_url "$app" "$version")"

  [[ -n "$url" ]] ||
    error "no package URL is defined for '$app' version '$version'"

  checksum="$(package_sha256 "$app" "$version")"

  # ----------------------------------------------------------
  # Already installed?
  #
  # install Qnote
  # install Qnote@1.5.0
  #
  # Both replace the existing installation.
  # ----------------------------------------------------------

  if is_installed "$app"; then
    local current_version

    current_version="$(installed_version "$app")"

    if [[ "$current_version" == "$version" ]]; then
      info "'$app' $version is already installed"
      exit 0
    fi

    info "'$app' $current_version is installed."
    info "Replacing it with '$app' $version..."

    uninstall_existing "$app"
  fi

  # ----------------------------------------------------------
  # Download
  # ----------------------------------------------------------

  temporary_dir="$(mktemp -d)"

  trap 'rm -rf "$temporary_dir"' RETURN
  archive="$temporary_dir/$(basename "${url%%\?*}")"

  info "Downloading '$app' $version $url"

  if ! download "$url" >"$archive"; then
    error "could not download '$app' $version"
  fi

  # ----------------------------------------------------------
  # Verify
  # ----------------------------------------------------------

  verify_checksum "$archive" "$checksum"

  # ----------------------------------------------------------
  # Extract
  # ----------------------------------------------------------

  info "Extracting '$app' $version..."

  mkdir -p "$temporary_dir/extracted"

  extract_archive \
    "$archive" \
    "$temporary_dir/extracted"

  package_root="$(
    find_package_root "$temporary_dir/extracted"
  )" || {
    error "'$app' package does not contain install.sh"
  }

  installer="$package_root/install.sh"

  chmod +x "$installer"

  # ----------------------------------------------------------
  # Install
  # ----------------------------------------------------------

  info "Installing '$app' $version..."

  (
    cd "$package_root"
    ./install.sh
  )

  # ----------------------------------------------------------
  # Installation succeeded.
  #
  # Keep uninstall.sh and everything else.
  # Remove install.sh.
  # ----------------------------------------------------------

  rm -f "$package_root/install.sh"

  app_dir="$APP_DIR/$app"

  rm -rf "$app_dir"

  mv "$package_root" "$app_dir"

  mark_installed "$app" "$version"

  info "'$app' $version installed."
}

cmd_uninstall() {

  local app="$1"

  ensure_catalog

  if ! is_installed "$app"; then
    info "'$app' is not installed"
    exit 0
  fi

  uninstall_existing "$app"

  info "'$app' uninstalled."
}

cmd_help() {

  cat <<EOF

MicroSH $VERSION

Tiny Linux application manager.

Usage:

  microsh list
      List applications and their latest versions.

  microsh update
      Update the local application catalog.

  microsh install <app>
      Install the latest version of an application.

  microsh install <app>@<version>
      Install a specific available version.

  microsh uninstall <app>
      Uninstall an application.

  microsh help
      Show this help.

  microsh version
      Show MicroSH version.

Examples:

  microsh update

  microsh list

  microsh install Qnote

  microsh install Qnote@1.5.0

  microsh uninstall Qnote

EOF
}

# ------------------------------------------------------------
# Main
# ------------------------------------------------------------

check_dependencies

COMMAND="${1:-help}"

case "$COMMAND" in

list)
  [[ $# -eq 1 ]] ||
    error "usage: microsh list"

  cmd_list
  ;;

update)
  [[ $# -eq 1 ]] ||
    error "usage: microsh update"

  cmd_update
  ;;

install)
  [[ $# -eq 2 ]] ||
    error "usage: microsh install <app>[@<version>]"

  cmd_install "$2"
  ;;

uninstall)
  [[ $# -eq 2 ]] ||
    error "usage: microsh uninstall <app>"

  cmd_uninstall "$2"
  ;;

help | -h | --help)
  [[ $# -eq 1 ]] ||
    error "usage: microsh help"

  cmd_help
  ;;

version | -v | --version)
  [[ $# -eq 1 ]] ||
    error "usage: microsh version"

  echo "MicroSH $VERSION"
  ;;

*)
  error "unknown command '$COMMAND'. Run 'microsh help'."
  ;;

esac
